{
  "manifest_version": 3,
  "name": "Knewledge Capture",
  "version": "0.1.0",
  "description": "Save one tab or clear a tab backlog into your private knowledge library.",
  "action": { "default_popup": "popup.html", "default_title": "Save to Knewledge" },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://app.knewledge.example/*"]
}

